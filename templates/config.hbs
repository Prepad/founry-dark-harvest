<form class="flexcol" autocomplete="off">
  <p style="opacity:.85; margin:0 0 8px 0;">
    Настройка волшебника, радиуса по уровням, прогрессии лечения кубами и расходуемой пассивной особенности.
    <br/><span style="opacity:.7">Логи в консоли начинаются с <b>Orel:</b></span>
  </p>

  <div class="form-group">
    <label>Wizard (Actor)</label>
    <div class="form-fields">
      <select name="wizardActor">
        {{#each actors}}
          <option value="{{this.id}}" {{#if (eq this.id ../wizardRef)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    <p class="notes">Выбирай Character-актёра волшебника. Диалог всплывает у OWNER этого актёра (не у GM).</p>
  </div>

  <div class="form-group">
    <label>Расходуемая пассивная особенность (Feature)</label>
    <div class="form-fields">
      <select name="usageFeature">
        <option value="">— без ограничений —</option>
        {{#each features}}
          <option value="{{this.id}}" {{#if (eq this.id ../usageRef)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    <p class="notes">Выбирай пассивную особенность у волшебника (обычно Item типа <b>feat</b>) с Uses. При применении пассивки тратится 1 использование.</p>
  </div>

  <hr/>

  <div class="form-group">
    <label>Radius progression preset</label>
    <div class="form-fields">
      <select name="radiusPreset">
        <option value="">— (не менять) —</option>
        {{#each radiusPresets}}
          <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>Radius progression (ft), JSON[20]</label>
    <div class="form-fields">
      <textarea name="radiusProgression" rows="3" style="font-family:monospace;">{{radiusProg}}</textarea>
    </div>
  </div>

  <div class="form-group">
    <label>Heal dice progression preset</label>
    <div class="form-fields">
      <select name="healDicePreset">
        <option value="">— (не менять) —</option>
        {{#each healDicePresets}}
          <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>Heal dice progression, JSON[20]</label>
    <div class="form-fields">
      <textarea name="healDiceProgression" rows="3" style="font-family:monospace;">{{healDiceProg}}</textarea>
    </div>
    <p class="notes">На уровне L формула кубов = arr[L-1], например "2d6+3". При исцелении: сначала выбирается цель, затем бросаются кубы.</p>
  </div>

  <div class="form-group">
    <label>Max restore slot level preset</label>
    <div class="form-fields">
      <select name="maxRestorePreset">
        <option value="">— (не менять) —</option>
        {{#each maxRestorePresets}}
          <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>Max restore slot level progression, JSON[20]</label>
    <div class="form-fields">
      <textarea name="maxRestoreSlotLevelProgression" rows="3" style="font-family:monospace;">{{maxRestore}}</textarea>
    </div>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fas fa-save"></i> Save</button>
  </footer>
</form>
